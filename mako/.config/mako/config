font=JetBrainsMono Nerd Font 11
background-color=#1a1b26
text-color=#c0caf5
border-color=#414868
border-size=1
border-radius=8

width=360
height=120
margin=10
padding=12
default-timeout=5000
ignore-timeout=0

anchor=top-right
layer=overlay

icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor

[urgency=low]
border-color=#565f89
default-timeout=3000

[urgency=normal]
border-color=#7aa2f7

[urgency=critical]
border-color=#f7768e
background-color=#2d1b2e
default-timeout=0
